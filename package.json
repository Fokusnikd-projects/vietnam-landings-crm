{
  "name": "lead-crm",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "npm run build && vite preview --configLoader runner --host 127.0.0.1 --port 4173 --strictPort",
    "build": "vite build --configLoader runner && node scripts/prepare-sites-build.mjs",
    "build:vercel": "vite build --configLoader runner",
    "preview": "vite preview --configLoader runner",
    "test": "node --test tests/data.test.mjs tests/googleSheet.test.mjs",
    "test:sites": "node --test tests/sites-worker.test.mjs",
    "lint": "eslint src tests",
    "typecheck": "tsc -p jsconfig.json --noEmit"
  },
  "dependencies": {
    "@vitejs/plugin-react": "5.0.4",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "vite": "6.4.2"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "eslint": "^9.39.5",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "globals": "^16.5.0",
    "typescript": "^5.9.3"
  }
}
